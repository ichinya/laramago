    /** @param self::REJECT_* $input */
    public function constantMixed(string $input,bool $first,bool $second):Receipt {
        $rows=[];
        try {
            return DeferredCallbacks::invoke(function()use($input,$first,$second,&$rows):Receipt {
                if (!$first) {
                    
                    $label=$input===self::REJECT_FIRST?'first':'second';
                    $rows[]=[$input];
                    throw new \RuntimeException('First deferred denial.');
                }
                if (!$second) {
                    $rows[]=[$input];
                    throw new \RuntimeException('Second deferred denial.');
                }
                return new Receipt;
            },3);
        } catch (\RuntimeException $failure) {
