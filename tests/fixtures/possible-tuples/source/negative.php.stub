    public function storedCapture(string $input,mixed $unknown):void {$rows=[];try {$stored=function()use($input,&$rows):Receipt{if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('First deferred denial.');} if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('Second deferred denial.');} return new Receipt;};DeferredCallbacks::invoke($stored,3);} catch (\RuntimeException $failure) {foreach($rows as[$value]){$this->acceptText($value);}}}
    public function referenceLoop(string $input,mixed $unknown):void {$rows=[];try {DeferredCallbacks::invoke(function()use($input,&$rows):Receipt{if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('First deferred denial.');} if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('Second deferred denial.');} return new Receipt;},3);} catch (\RuntimeException $failure) {foreach($rows as [&$value]){$this->acceptText($value);}}}
    public function duplicateProjection(string $input,mixed $unknown):void {$rows=[];try {DeferredCallbacks::invoke(function()use($input,$unknown,&$rows):Receipt{if (\random_int(0,1)===1) {return new Receipt;}$rows[]=[$input,$unknown];throw new \RuntimeException('Deferred write boundary.');},3);} catch (\RuntimeException $failure) {foreach($rows as[$value,$value]){$this->acceptText($value);}}}
    public function nonArrayWrite(string $input,mixed $unknown):void {$rows=[];try {DeferredCallbacks::invoke(function()use($input,&$rows):Receipt{if (\random_int(0,1)===1) {return new Receipt;}$rows[]=42;throw new \RuntimeException('Deferred write boundary.');},3);} catch (\RuntimeException $failure) {foreach($rows as[$value]){$this->acceptText($value);}}}
    public function differentArity(string $input,mixed $unknown):void {$rows=[];try {DeferredCallbacks::invoke(function()use($input,$unknown,&$rows):Receipt{if (\random_int(0,1)===1) {return new Receipt;}$rows[]=[$unknown,$input];throw new \RuntimeException('Deferred write boundary.');},3);} catch (\RuntimeException $failure) {foreach($rows as[$value]){$this->acceptText($value);}}}
