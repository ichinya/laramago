<?php
declare(strict_types=1);
namespace Fixture\TypedTuples;
class NegativeRows {
    public const REJECT_FIRST='alpha';
    public const REJECT_SECOND=7;
    public function alias(string $input,mixed $unknown):void {$rows=[];try {$alias=$rows;DeferredCallbacks::invoke(function()use($input,&$rows):Receipt{if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('First deferred denial.');} if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('Second deferred denial.');} return new Receipt;},3);} catch (\RuntimeException $failure) {foreach($rows as[$value]){$this->acceptText($value);}}}
