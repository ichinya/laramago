    public function inputReference(string $input,mixed $unknown):void {$rows=[];try {DeferredCallbacks::invoke(function()use($input,&$rows):Receipt{$alias=&$input;if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('First deferred denial.');} if (\random_int(0,1)===0) {$rows[]=[$input];throw new \RuntimeException('Second deferred denial.');} return new Receipt;},3);} catch (\RuntimeException $failure) {foreach($rows as[$value]){$this->acceptText($value);}}}
