<?php
use Illuminate\Database\Eloquent\Model;
enum BodyScopeStatus: string { case Active = 'active'; }
enum BodyScopeFlag { case Visible; }
class BodyScopeMagic { public const Status = 'active'; }
trait BodyScopeTrait {
    public function scopeVisible($query) { return $query->where('visible', true); }
}
class BodyScopeRecord extends Model {
    use BodyScopeTrait;
    public function scopeActive($query) { return $query->where('active', true); }
    public function scopeEnumValue($query) { return $query->where('status', BodyScopeStatus::Active->value); }
    public function scopeEnumName($query) { return $query->where('flag', BodyScopeFlag::Visible->name); }
    public function scopeMissingCase($query) { return $query->where('status', BodyScopeStatus::Missing->value); }
    public function scopeUnitValue($query) { return $query->where('status', BodyScopeFlag::Visible->value); }
    public function scopeMagicValue($query) { return $query->where('status', BodyScopeMagic::Status->value); }
    public function scopeNamed($query, string $name) { return $query->where('name', $name)->orWhere('name', 'public'); }
    public function scopeIdentity($query) { return $query; }
    public function scopeScalar($query) { return 42; }
    public function scopeUnknown($query) { return $query->custom(); }
    public function scopeMutated($query) { $query = new \stdClass; return $query->where('a', true); }
    public function scopeAssignment($query) { return $query->where('a', $query = new \stdClass); }
    public function scopeEscaped($query) { return $query->where('a', change($query)); }
    public function scopeClosure($query) { return $query->where(function () use (&$query) { $query = null; }); }
    public function scopeArrayMutation($query) { return $query->where(['a' => $query = null]); }
    /** @return mixed */
    public function scopeMixed($query) { return $query->where('a', true); }
    public function scopeTyped($query): string { return 'explicit'; }
}
class ChildBodyScopeRecord extends BodyScopeRecord {}
/** @method static string active() */
class DocumentedBodyScopeRecord extends BodyScopeRecord {}
class CustomBodyScopeRecord extends BodyScopeRecord {
    public function newEloquentBuilder($query) { return new \stdClass; }
}
