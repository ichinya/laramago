class CallbackInferred extends Model
{
    public function one(): \Illuminate\Database\Eloquent\Relations\HasOne { return $this->hasOne(CallbackPost::class); }
    public function parent(): \Illuminate\Database\Eloquent\Relations\BelongsTo { return $this->belongsTo(CallbackPost::class); }
