    private function hidden(): HasMany { return $this->hasMany(CallbackPost::class); }
    protected function protectedPosts(): HasMany { return $this->hasMany(CallbackPost::class); }
    public static function staticPosts(): HasMany { throw new LogicException('Never execute'); }
    /** @return HasMany<Model, $this> */
