    public function through(): \Illuminate\Database\Eloquent\Relations\HasManyThrough { return $this->hasManyThrough(CallbackPost::class, CallbackRecord::class); }
    public function throughOne(): \Illuminate\Database\Eloquent\Relations\HasOneThrough { return $this->hasOneThrough(CallbackPost::class, CallbackRecord::class); }
    public function image(): \Illuminate\Database\Eloquent\Relations\MorphOne { return $this->morphOne(CallbackPost::class, 'imageable'); }
    public function images(): \Illuminate\Database\Eloquent\Relations\MorphMany { return $this->morphMany(CallbackPost::class, 'imageable'); }
    public function tags(): \Illuminate\Database\Eloquent\Relations\MorphToMany { return $this->morphToMany(CallbackPost::class, 'taggable'); }
    public function inverseTags(): \Illuminate\Database\Eloquent\Relations\MorphToMany { return $this->morphedByMany(CallbackPost::class, 'taggable'); }
