    public function chained(): HasMany { return $this->hasMany(CallbackPost::class)->where('active', true); }
    public function parameterized(string $key = 'id'): HasMany { return $this->hasMany(CallbackPost::class); }
    public function customPosts(): HasMany { return $this->hasMany(CallbackCustomPost::class); }
}
