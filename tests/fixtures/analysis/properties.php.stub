<?php

namespace Example;

use Carbon\CarbonImmutable;
use Illuminate\Database\Eloquent\Casts\Attribute;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\Relations\HasOne;

// Any attempt to load model source as PHP must fail the integration test.
file_put_contents(__DIR__.'/model-executed', 'Unexpected application execution');
throw new \RuntimeException('Model source must only be parsed.');

enum Status: string { case Draft = 'draft'; case Published = 'published'; }

/**
 * @property string $documented
 * @property-read string $read_only
 * @property-write string $write_only
 */
class Person extends Model
{
    public string $declared = 'contract';
    protected $casts = ['active' => 'boolean', 'amount' => 'decimal:2', 'settings' => 'array', 'status' => Status::class];

    protected function casts(): array
    {
        return ['published_at' => 'immutable_datetime', 'score' => 'integer'];
    }

    public function getDisplayNameAttribute(): string { return 'Example'; }
    public function setAliasAttribute(string $value): void {}

    /** @return Attribute<string, int> */
    protected function label(): Attribute { throw new \LogicException; }

    public function manager(): BelongsTo { return $this->belongsTo(Person::class); }
    public function members(): HasMany { return $this->hasMany(Person::class); }
    /** @return HasOne<Person|UnknownRecord> */
    public function unionParent(): HasOne { return $this->hasOne(Person::class); }
    /** @return HasOne<Person|UnknownRecord> */
    public function defaultUnionParent(): HasOne { return $this->hasOne(Person::class)->withDefault(); }
    /** @return HasMany<Person|CollectionPerson> */
    public function customUnionMembers(): HasMany { return $this->hasMany(Person::class); }
    /** @return HasMany<Person|UnknownRecord> */
    public function unionMembers(): HasMany { return $this->hasMany(Person::class); }
    /** @return HasMany<Person|string> */
    public function invalidUnionMembers(): HasMany { return $this->hasMany(Person::class); }
    /** @return HasMany<string> */
    public function invalidRelatedContract(): HasMany { return $this->hasMany(Person::class); }
    public function customMembers(): HasMany { return $this->hasMany(CollectionPerson::class); }
    public function inheritedCollectionMembers(): HasMany { return $this->hasMany(ChildCollectionPerson::class); }
    public function attributedCollectionMembers(): HasMany { return $this->hasMany(AttributeCollectionPerson::class); }
    public function propertyCollectionMembers(): HasMany { return $this->hasMany(PropertyCollectionPerson::class); }
    public function genericCollectionMembers(): HasMany { return $this->hasMany(GenericCollectionPerson::class); }
    public function unknownCollectionMembers(): HasMany { return $this->hasMany(UnknownCollectionPerson::class); }
    public function unknownCollectionParent(): HasOne { return $this->hasOne(UnknownCollectionPerson::class); }
    public function profile(): HasOne { return $this->hasOne(Person::class)->withDefault(); }
    public function emptyDefault(): HasOne { return $this->hasOne(Person::class)->withDefault([]); }
    public function falseDefault(): HasOne { return $this->hasOne(Person::class)->withDefault(false); }
    public function populatedDefault(): HasOne { return $this->hasOne(Person::class)->withDefault(['name' => 'Guest']); }
    public function clearedDefault(): HasOne { return $this->hasOne(Person::class)->withDefault()->withDefault([]); }
    public function restoredDefault(): HasOne { return $this->hasOne(Person::class)->withDefault([])->withDefault(); }
    public function callbackDefault(): HasOne { return $this->hasOne(Person::class)->withDefault(function () { return 'custom'; }); }
    public function callableArrayDefault(): HasOne { return $this->hasOne(Person::class)->withDefault([self::class, 'defaultFactory']); }
    public function dynamicCallableDefault(): HasOne { return $this->hasOne(Person::class)->withDefault([self::class, $this->defaultMethod()]); }
    public function defaultMethod(): string { return 'defaultFactory'; }
    public static function defaultFactory(): string { return 'custom'; }
    private function privateManager(): BelongsTo { return $this->belongsTo(Person::class); }
    protected function protectedManager(): BelongsTo { return $this->belongsTo(Person::class); }

    /** @return BelongsTo<Person> */
    public function documentedManager(): BelongsTo { throw new \LogicException; }
}

class BaseRecord extends Model { protected $table = 'people'; }
/** @extends \Illuminate\Database\Eloquent\Collection<int, Person> */
class PersonCollection extends \Illuminate\Database\Eloquent\Collection { public function summary(): string { throw new \LogicException('Never execute collections.'); } }
class CollectionPerson extends Person { public function newCollection(array $models = []): PersonCollection { throw new \LogicException('Never execute collection factories.'); } }
class ChildCollectionPerson extends CollectionPerson {}
#[\Illuminate\Database\Eloquent\Attributes\CollectedBy(PersonCollection::class)]
class AttributeCollectionPerson extends Person {}
class PropertyCollectionPerson extends Person { protected static string $collectionClass = PersonCollection::class; }
/** @template T of Model
 * @extends \Illuminate\Database\Eloquent\Collection<int, T> */
class GenericPersonCollection extends \Illuminate\Database\Eloquent\Collection {}
class GenericCollectionPerson extends Person {
    /** @return GenericPersonCollection<Person> */
    public function newCollection(array $models = []): GenericPersonCollection { throw new \LogicException('Never execute collection factories.'); }
}
class UnknownCollectionPerson extends Person { public function newCollection(array $models = []) { throw new \LogicException('Never execute collection factories.'); } }
/** @property-read string $customMembers */
class DocumentedCollectionOwner extends Person {}
class InheritedRecord extends BaseRecord {}
class InheritedPerson extends Person { protected $table = 'people'; }
class DisabledTimestamps extends Person { protected $table = 'people'; public $timestamps = false; }
class CustomTimestampNames extends Person {
    protected $table = 'people';
    public const CREATED_AT = 'born_at';
    public const UPDATED_AT = 'changed_at';
}
/** @property string $created_at */
class DocumentedTimestamp extends Person { protected $table = 'people'; }
class CustomGetDates extends Person { protected $table = 'people'; public function getDates(): array { return []; } }
class CustomRelationValue extends Person { protected $table = 'people'; public function getRelationValue($key) { return 'custom'; } }
class CustomRelationResult extends Person { protected function getRelationshipFromMethod($method) { return 'custom'; } }
class CustomRelationDetection extends Person { public function isRelation($key) { return false; } }
class SelfPerson extends Model
{
    public function manager(): BelongsTo { return $this->belongsTo(self::class); }
    public function peer(): BelongsTo { return $this->belongsTo(static::class); }
}
class InheritedSelfPerson extends SelfPerson { public function childOnly(): void {} }
trait HasRating { protected function casts(): array { return ['rating' => 'int']; } }
class RatedRecord extends Model { use HasRating; }
class CustomKey extends Model
{
    protected $table = 'keys';
    protected $primaryKey = 'code';
    protected $keyType = 'string';
    public $incrementing = false;
}
class UnknownRecord extends Model
{
    protected $fillable = ['imaginary'];
    protected $casts = ['enabled' => 'boolean', 'mystery' => 'UnimplementedCast'];
}
class ConditionalRecord extends Model { protected $table = 'conditional_records'; }
class ChangedRecord extends Model { protected $table = 'changed_records'; }
class ExtraRecord extends Model {}
class UntypedAccessor extends Model
{
    protected $table = 'people';
    public function getNameAttribute($value) { return $value; }
}
class CustomDispatcher extends Model
{
    protected $table = 'people';
    public function __get(string $key): mixed { return null; }
}
class OtherConnection extends Model { protected $table = 'people'; protected $connection = 'remote'; public $incrementing = false; }
class DynamicRecord extends Model
{
    protected $table = 'people';
    protected function casts(): array { return $this->loadDynamicCasts(); }
}

function acceptStatus(Status $status): void {}
function acceptString(string $value): void {}
