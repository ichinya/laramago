<?php

namespace Illuminate\Database\Eloquent\Casts {
    class Attribute {}
}

namespace Example {
    use Illuminate\Database\Eloquent\Attributes\Appends;
    use Illuminate\Database\Eloquent\Attributes\Fillable;
    use Illuminate\Database\Eloquent\Attributes\Guarded;
    use Illuminate\Database\Eloquent\Attributes\Hidden;
    use Illuminate\Database\Eloquent\Attributes\Unguarded;
    use Illuminate\Database\Eloquent\Attributes\Visible;
    use Illuminate\Database\Eloquent\Casts\Attribute;
    use Illuminate\Database\Eloquent\Model;

    class JsonCast {}

    final class LiteralFields
    {
        public const KNOWN = 'known';
        public const DYNAMIC = ['known'];
    }

    class CompleteRecord extends Model
    {
        protected $casts = ['virtual' => 'array'];
        protected $fillable = ['known', 'profile->enabled', 'nullable_value', 'virtual', 'missing']; // complete-missing

        public function setVirtualAttribute(array $value): void
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class OpenRecord extends Model
    {
        protected $fillable = ['missing'];
    }

    class CompleteGuardedRecord extends Model
    {
        protected $guarded = ['known', 'TITLE', 'missing']; // guarded-missing
    }

    class GuardedWildcardRecord extends Model
    {
        protected $guarded = ['*'];
    }

    class GuardedMixedWildcardRecord extends Model
    {
        protected $guarded = ['*', 'missing']; // guarded-mixed-missing
    }

    class DynamicGuardedRecord extends Model
    {
        protected $guarded = ['key' => 'missing', ...LiteralFields::DYNAMIC];
    }

    class CompleteHiddenRecord extends Model
    {
        protected $hidden = [
            'known',
            'userProfile',
            'display_name',
            'user_profile', // hidden-output-key
            'missing', // hidden-missing
        ];
    }

    class OpenHiddenRecord extends Model
    {
        protected $hidden = ['missing'];
    }

    class DynamicHiddenRecord extends Model
    {
        protected $hidden = ['key' => 'missing', ...LiteralFields::DYNAMIC];
    }

    class MalformedSerializationRecord extends Model
    {
        protected $hidden = ['missing'];
    }

    class CompleteVisibleRecord extends Model
    {
        protected $visible = [
            'known',
            'userProfile',
            'display_name',
            'user_profile', // visible-output-key
            'Known', // visible-case-mismatch
            'missing', // visible-missing
        ];
    }

    class EmptyVisibleRecord extends Model
    {
        protected $visible = [];
    }

    class OpenVisibleRecord extends Model
    {
        protected $visible = ['missing'];
    }

    class DynamicVisibleRecord extends Model
    {
        protected $visible = ['key' => 'missing', ...LiteralFields::DYNAMIC];
    }

    class CompleteAppendsRecord extends Model
    {
        protected $casts = [
            'class_value' => JsonCast::class,
            'primitive_value' => 'array',
        ];
        protected $appends = [
            'legacy_value',
            'modern_value',
            'class_value',
            'known', // appends-field-only
            'userProfile', // appends-serialization-only
            'primitive_value', // appends-primitive-cast
            'Legacy_Value', // appends-case-mismatch
            'missing', // appends-missing
        ];

        public function getLegacyValueAttribute(): string
        {
            throw new \RuntimeException('Must not execute');
        }

        protected function modernValue(): Attribute
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class OpenAppendsRecord extends Model
    {
        protected $appends = ['missing'];
    }

    class AppendsOnlyRecord extends Model
    {
        protected $appends = ['legacy_value', 'missing']; // appends-only-missing

        public function getLegacyValueAttribute(): string
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class IncompleteAppendsRecord extends Model
    {
        protected $appends = ['missing'];
    }

    class DynamicAppendsRecord extends Model
    {
        protected $appends = ['key' => 'missing', ...LiteralFields::DYNAMIC];
    }

    class MalformedAppendsRecord extends Model
    {
        protected $appends = ['missing'];
    }

    class CustomGetAppendsRecord extends Model
    {
        protected $appends = ['missing'];

        public function getAppends(): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomAppendMutationRecord extends Model
    {
        protected $appends = ['missing'];

        protected function mutateAttributeForArray($key, $value): mixed
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class ChildRecord extends CompleteRecord
    {
        protected $fillable = ['missing'];
    }

    class DynamicRecord extends Model
    {
        protected $fillable = [LiteralFields::KNOWN, 'missing']; // literal-missing
    }

    class UnpackedRecord extends Model
    {
        protected $fillable = ['key' => 'missing', ...LiteralFields::DYNAMIC];
    }

    class CustomConnectionRecord extends Model
    {
        protected $fillable = ['remote_only'];

        public function getConnectionName(): string
        {
            throw new \RuntimeException('Must not execute');
        }

        public function getTable(): string
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomGetFillableRecord extends Model
    {
        protected $fillable = ['missing'];

        public function getFillable(): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomGetGuardedRecord extends Model
    {
        protected $guarded = ['missing'];

        public function getGuarded(): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomIsGuardedRecord extends Model
    {
        protected $guarded = ['missing'];

        public function isGuarded($key)
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomIsFillableRecord extends Model
    {
        protected $fillable = ['missing'];
        protected $guarded = ['missing'];

        public function isFillable(string $key): bool
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomGetHiddenRecord extends Model
    {
        protected $hidden = ['missing'];

        public function getHidden(): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomGetVisibleRecord extends Model
    {
        protected $visible = ['missing'];

        public function getVisible(): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomToArrayRecord extends Model
    {
        protected $hidden = ['missing'];

        public function toArray(): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomArrayableItemsRecord extends Model
    {
        protected $hidden = ['missing'];

        protected function getArrayableItems(array $values): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomFillRecord extends Model
    {
        protected $fillable = ['missing'];
        protected $guarded = ['missing'];

        public function fill(array $attributes): static
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class CustomMassAssignmentRecord extends Model
    {
        protected $fillable = ['missing'];
        protected $guarded = ['missing'];

        protected function fillableFromArray(array $attributes): array
        {
            throw new \RuntimeException('Must not execute');
        }
    }

    class MalformedCatalogRecord extends Model
    {
        protected $fillable = ['missing'];
    }

    class DuplicateCatalogRecord extends Model
    {
        protected $fillable = ['missing'];
    }

    #[Fillable(['known', 'missing'])] // attribute-fillable-missing
    class AttributeFillableRecord extends Model {}

    #[Fillable('known', 'missing')] // attribute-fillable-variadic-missing
    class AttributeVariadicFillableRecord extends Model {}

    #[Guarded('TITLE', 'missing')] // attribute-guarded-missing
    class AttributeGuardedRecord extends Model {}

    #[Guarded('*')]
    class AttributeGuardedWildcardRecord extends Model {}

    #[Hidden(['known', 'userProfile', 'missing'])] // attribute-hidden-missing
    class AttributeHiddenRecord extends Model {}

    #[Visible('known', 'display_name', 'missing')] // attribute-visible-missing
    class AttributeVisibleRecord extends Model {}

    #[Appends(['legacy_value', 'missing'])] // attribute-appends-missing
    class AttributeAppendsRecord extends Model {}

    #[Fillable(['attribute_missing'])] // attribute-combined-fillable-missing
    class AttributeAndPropertyFillableRecord extends Model
    {
        protected $fillable = ['property_missing']; // attribute-combined-property-missing
    }

    #[Guarded(['ignored_attribute_missing'])]
    class AttributeAndPropertyGuardedRecord extends Model
    {
        protected $guarded = ['property_missing']; // attribute-guarded-property-wins
    }

    #[Guarded('ignored_attribute_missing')]
    class AttributeNonDefaultGuardedRecord extends Model
    {
        protected $guarded = [];
    }

    #[Unguarded]
    #[Guarded('ignored_attribute_missing')]
    class AttributeUnguardedRecord extends Model {}

    class AttributeGuardedParentRecord extends Model
    {
        protected $guarded = [];
    }

    #[Guarded('ignored_inherited_property_missing')]
    class AttributeGuardedChildRecord extends AttributeGuardedParentRecord {}

    #[Unguarded]
    class AttributeUnguardedParentRecord extends Model {}

    #[Guarded('ignored_inherited_unguarded_missing')]
    class AttributeUnguardedChildRecord extends AttributeUnguardedParentRecord {}

    // Laravel's constructor uses only the first argument when it is an array.
    #[Fillable(['known'], 'ignored_missing')]
    class AttributeArrayFirstRecord extends Model {}

    #[Fillable(LiteralFields::KNOWN, 'missing')]
    class AttributeDynamicFirstRecord extends Model {}

    #[Fillable(['field' => 'missing'])]
    class AttributeKeyedArrayRecord extends Model {}

    #[Fillable(['missing'])]
    class AttributeCustomConstructorRecord extends Model
    {
        public function __construct() {}
    }

    #[Hidden(['missing'])]
    class AttributeCustomInitializerRecord extends Model
    {
        public function initializeHidesAttributes(): void {}
    }

    #[Appends(['missing'])]
    class AttributeCustomResolverRecord extends Model
    {
        protected static function resolveClassAttribute(
            string $attributeClass,
            ?string $property = null,
            ?string $class = null,
        ): mixed {
            return null;
        }
    }

    #[Appends(['missing'])]
    class AttributeCustomSetAppendsRecord extends Model
    {
        public function setAppends(array $appends): static
        {
            return $this;
        }
    }

    #[\Example\CustomFillable(['missing'])]
    class CustomAttributeRecord extends Model {}

    #[Hidden(['inherited_missing'])]
    class AttributeParentRecord extends Model {}

    class AttributeChildRecord extends AttributeParentRecord {}

    #[\Attribute(\Attribute::TARGET_CLASS)]
    class CustomFillable
    {
        public function __construct(array|string ...$columns) {}
    }
}
