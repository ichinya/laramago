<?php

declare(strict_types=1);

namespace Illuminate\Support\Facades;

/**
 * @method static \Illuminate\Routing\Route fallback(mixed $action)
 * @method static \Illuminate\Routing\Route redirect(string $uri, string $destination, int $status = 302)
 * @method static \Illuminate\Routing\Route permanentRedirect(string $uri, string $destination)
 * @method static \Illuminate\Routing\Route view(string $uri, string $view, array $data = [], int|array $status = 200, array $headers = [])
 * @method static \Illuminate\Routing\Route get(string $uri, mixed $action = null)
 * @method static \Illuminate\Routing\Route match(array $methods, string $uri, mixed $action = null)
 */
class Route extends Facade
{
    protected static function getFacadeAccessor(): string
    {
        return 'router';
    }
}

class CustomRouteFacade extends Route {}
