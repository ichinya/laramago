<?php use Illuminate\Database\Eloquent\Collection; abstract class SourceCase2 extends Reader { public function run(): void { intSink("independent invalid scalar"); $query = Row::query();  $query->chunkById(10, function (Collection $items): void { foreach ($items as $row) { try { $row->recalculate(); } catch (\RuntimeException $error) { nullableSink($row->nullable); } } }); }}