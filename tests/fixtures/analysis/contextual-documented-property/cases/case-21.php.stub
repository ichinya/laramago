<?php use Illuminate\Database\Eloquent\Collection; abstract class SourceCase21 extends Reader { public function run(): void { intSink("independent invalid scalar"); $query = Row::query(); $query->where("active", true)->setModel(new OtherRow); $query->chunkById(10, function (Collection $items): void { foreach ($items as $row) { try { $row->recalculate(); } catch (\RuntimeException $error) { intSink($row->id); } } }); }}