 */
function typedComparatorParameter(array $rows):array {
    foreach($rows as $row) { if(!is_array($row)||!is_string($row['label']??null)) { throw new \InvalidArgumentException; } }
    usort($rows,fn(\stdClass $first,\stdClass $second)=>$first['label']<=>$second['label']);
