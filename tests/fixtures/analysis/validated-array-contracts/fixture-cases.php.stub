namespace ValidatedArrayExamples;

/** @param list<mixed> $rows
 * @return list<array{ticket:int|null,label:string,duration:int}>
 */
function sortedValidated(array $rows):array {
    foreach($rows as $row) {
        if(!is_array($row) || !array_key_exists('ticket',$row)
            || ($row['ticket']!==null && !is_int($row['ticket']))
            || !is_string($row['label']??null) || !is_int($row['duration']??null)) {
            throw new \InvalidArgumentException('Malformed record.');
        }
    }
    usort($rows,fn($left,$right)=>($left['label']<=>$right['label'])
        ?:($left['ticket']===$right['ticket']?0:($left['ticket']===null?1:($right['ticket']===null?-1:$left['ticket']<=>$right['ticket']))));
    return $rows;
}

/** @param list<array{ticket:int|null,label:string,duration:int}> $rows
 * @return list<array{ticket:int|null,label:string,duration:int}>
 */
function alreadyTyped(array $rows):array {
    usort($rows,fn($left,$right)=>$left['label']<=>$right['label']); return $rows;
}

