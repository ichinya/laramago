<?php
namespace Illuminate\Http;
/** An invented declaration with the upstream physical route() body; never executed. */
class Request
{
    /**
     * @param string|null $param
     * @param mixed $default
     * @return ($param is null ? \Illuminate\Routing\Route : object|string|null)
     */
    public function route($param = null, $default = null)
    {
        $route = call_user_func($this->getRouteResolver());
        if (is_null($route) || is_null($param)) {
            return $route;
        }
        return $route->parameter($param, $default);
    }
    /** @return \Closure(): (\Illuminate\Routing\Route|null) */
    public function getRouteResolver(): \Closure
    {
        return static fn (): ?\Illuminate\Routing\Route => null;
    }
}
