{
    "name": "ichinya/laramago",
    "description": "Laravel presets for the native Mago CLI, configured automatically by Composer.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0",
        "carthage-software/mago": "^1.48.1",
        "doctrine/inflector": "^2.1",
        "nikic/php-parser": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "Ichinya\\Laramago\\": "src/"
        }
    },
    "extra": {
        "class": "Ichinya\\Laramago\\Plugin"
    },
    "scripts": {
        "test": ["@php tests/run.php", "@php tests/preset.php", "@php tests/analyzer.php", "@php tests/properties.php", "@php tests/factories.php", "@php tests/find.php", "@php tests/create.php", "@php tests/validation.php", "@php tests/queries.php", "@php tests/scopes.php", "@php tests/casts.php", "@php tests/builders.php", "@php tests/relations.php", "@php tests/relation-names.php", "@php tests/relation-callbacks.php", "@php tests/builder-forwarding.php", "@php tests/generics.php", "@php tests/auth-types.php", "@php tests/collection-operations.php", "@php tests/advanced-casts.php", "@php tests/factory-collections.php", "@php tests/facade-roots.php", "@php tests/configuration.php", "@php tests/translation-strings.php", "@php tests/route-parameters.php", "@php tests/framework-contracts.php", "@php tests/macros.php", "@php tests/macro-contracts.php", "@php tests/higher-order-map.php", "@php tests/migration-locals.php", "@php tests/predicates.php", "@php tests/relation-methods.php", "@php tests/request-fields.php", "@php tests/auth-chains.php", "@php tests/collection-properties.php", "@php tests/facade-calls.php", "@php tests/http-tests.php", "@php tests/http-contracts.php", "@php tests/query-projections.php", "@php tests/macro-callables.php", "@php tests/generic-casts.php", "@php tests/migration-literals.php", "@php tests/migration-contracts.php", "@php tests/laratesto-responses.php", "@php tests/auth-contracts.php", "@php tests/mixed-reproductions.php", "@php tests/relation-contracts.php", "@php tests/query-chains.php", "@php tests/builder-generics.php", "@php tests/request-nested.php", "@php tests/collection-contracts.php", "@php tests/container-bindings.php", "@php tests/cast-contracts.php"],
        "check": ["@composer validate --strict", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": ["/var/", "/vendor/", "/composer.lock"]
    }
}
