{
    "name": "ichinya/laramago",
    "description": "Laravel presets for the native Mago CLI, configured automatically by Composer.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0",
        "carthage-software/mago": "^1.48.1",
        "doctrine/inflector": "^2.1",
        "nikic/php-parser": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "Ichinya\\Laramago\\": "src/"
        }
    },
    "extra": {
        "class": "Ichinya\\Laramago\\Plugin"
    },
    "scripts": {
        "test": ["@php tests/run.php", "@php tests/preset.php", "@php tests/analyzer.php", "@php tests/properties.php", "@php tests/factories.php", "@php tests/find.php", "@php tests/create.php"],
        "check": ["@composer validate --strict", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": ["/var/", "/vendor/", "/composer.lock"]
    }
}
