#!/usr/bin/env php
<?php

declare(strict_types=1);

use Ichinya\Laramago\Analyzer\StaticAnalysis\StaticMetadataExport;
use Ichinya\Laramago\Metadata\ConfigurationWatch;
use Ichinya\Laramago\Metadata\ControllerRouteContractExport;
use Ichinya\Laramago\Metadata\EnvironmentTemplateDuplicates;
use Ichinya\Laramago\Metadata\EnvironmentTemplateReferences;
use Ichinya\Laramago\Metadata\JsonTranslationMetadataExport;
use Ichinya\Laramago\Metadata\MiddlewareParameterMetadataExport;
use Ichinya\Laramago\Metadata\PolicyAdditionalArgumentContractExport;
use Ichinya\Laramago\Metadata\PolicyClassSelectorCallExport;
use Ichinya\Laramago\Metadata\PolicyModelArgumentContractExport;
use Ichinya\Laramago\Metadata\RouteMetadataExport;
use Ichinya\Laramago\Metadata\RouteNameDuplicateCandidates;
use Ichinya\Laramago\Metadata\RouteParameterMetadataExport;
use Ichinya\Laramago\Metadata\SelectedSourceWatch;
use Ichinya\Laramago\Metadata\TranslationMetadataExport;
use Ichinya\Laramago\Metadata\TranslationPlaceholderExport;
use Ichinya\Laramago\Metadata\ViteEnvironmentReferences;

// Composer's application autoloader may include application files. This command loads
// only this package's syntax reader and the installed PHP parser dependency.
$packageRoot = dirname(__DIR__);
$vendorRoot = is_dir($packageRoot.'/vendor/nikic/php-parser/lib/PhpParser')
    ? $packageRoot.'/vendor'
    : (
        isset($_composer_autoload_path) && is_string($_composer_autoload_path)
            ? dirname($_composer_autoload_path)
            : dirname($packageRoot, 2)
    );
$parserRoot = $vendorRoot.'/nikic/php-parser/lib/PhpParser';
if (! is_dir($parserRoot)) {
    fwrite(STDERR, "Cannot find the installed nikic/php-parser dependency.\n");
    exit(2);
}

spl_autoload_register(static function (string $class) use ($packageRoot, $parserRoot): void {
    foreach ([
        'Ichinya\\Laramago\\Analyzer\\StaticAnalysis\\' => $packageRoot.'/src/Analyzer/StaticAnalysis/',
        'Ichinya\\Laramago\\Metadata\\' => $packageRoot.'/src/Metadata/',
        'PhpParser\\' => $parserRoot.'/',
    ] as $prefix => $directory) {
        if (str_starts_with($class, $prefix)) {
            $file = $directory.str_replace('\\', '/', substr($class, strlen($prefix))).'.php';
            if (is_file($file)) {
                require $file;
            }

            return;
        }
    }
});

$usage = "Usage: laramago-metadata [--project-root DIR] [--kind configuration|policy-additional-argument-contract-candidates|policy-class-selector-call-candidates|policy-model-argument-contract-candidates|middleware-parameters|controller-route-contract-candidates|routes|route-name-duplicates|route-parameters|translations|translations-json|translation-placeholders|environment-references|environment-duplicates|vite-environment-references] [--source FILE ...] [--config-array KEY ...] [--config-key KEY ...] [--output FILE] [--watch [--interval-ms 50..60000]]\n";
$root = getcwd() ?: '';
$kind = 'configuration';
$files = [];
$arrayKeys = [];
$keys = [];
$output = null;
$watchMode = false;
$intervalMs = 500;
$intervalSpecified = false;
$error = null;
for ($i = 1; $i < count($argv); $i++) {
    $argument = $argv[$i];
    if ($argument === '--help' || $argument === '-h') {
        fwrite(STDOUT, $usage);
        exit(0);
    }
    if ($argument === '--watch') {
        $watchMode = true;
        continue;
    }
    if (! in_array(
        $argument,
        ['--project-root', '--kind', '--source', '--config-array', '--config-key', '--output', '--interval-ms'],
        true,
    )) {
        $error = 'Unknown option: '.$argument;
        break;
    }
    if (! isset($argv[$i + 1]) || str_starts_with($argv[$i + 1], '--')) {
        $error = 'Missing value for '.$argument;
        break;
    }
    $value = $argv[++$i];
    switch ($argument) {
        case '--kind':
            $kind = $value;
            break;
        case '--source':
            $files[] = $value;
            break;
        case '--project-root':
            $root = $value;
            break;
        case '--config-array':
            $arrayKeys[] = $value;
            break;
        case '--config-key':
            $keys[] = $value;
            break;
        case '--output':
            $output = $value;
            break;
        case '--interval-ms':
            if (! ctype_digit($value) || (int) $value < 50 || (int) $value > 60000) {
                $error = 'Watch interval must be between 50 and 60000 milliseconds.';
            } else {
                $intervalMs = (int) $value;
                $intervalSpecified = true;
            }
            break;
    }
}

if ($error === null && ! is_dir($root)) {
    $error = 'Project root is not a directory.';
}
if ($watchMode && $output !== null) {
    $error = '--output cannot be used with --watch.';
}
if (! $watchMode && $intervalSpecified) {
    $error = '--interval-ms requires --watch.';
}
if (! in_array(
    $kind,
    [
        'configuration',
        'policy-model-argument-contract-candidates',
        'policy-class-selector-call-candidates',
        'policy-additional-argument-contract-candidates',
        'middleware-parameters',
        'controller-route-contract-candidates',
        'routes',
        'route-name-duplicates',
        'route-parameters',
        'translations',
        'translation-placeholders',
        'environment-references',
        'environment-duplicates',
        'vite-environment-references',
        'translations-json',
    ],
    true,
)) {
    $error = 'Unsupported metadata kind.';
} elseif ($kind === 'configuration' && $files !== []) {
    $error = '--source requires a source metadata kind.';
} elseif ($kind !== 'configuration') {
    if ($files === []) {
        $error = 'This metadata kind requires at least one --source file.';
    } elseif ($arrayKeys !== [] || $keys !== []) {
        $error = 'Configuration filters require --kind configuration.';
    } elseif ($watchMode && ! in_array($kind, ['routes', 'translations', 'translations-json'], true)) {
        $error = '--watch supports configuration, route, and translation source metadata only.';
    }
}
foreach ($arrayKeys as $arrayKey) {
    if (! preg_match('/^[^.]+(?:\.[^.]+)*$/D', $arrayKey)) {
        $error = 'Configuration array key must have nonempty dotted segments.';
    }
}
foreach ($keys as $key) {
    if (! preg_match('/^[^.]+(?:\.[^.]+)+$/D', $key)) {
        $error = 'Configuration key must have at least two nonempty dotted segments.';
    }
}
if ($error !== null) {
    fwrite(STDERR, $error."\n".$usage);
    exit(2);
}

$root = realpath($root);
if ($root === false) {
    fwrite(STDERR, "Unable to resolve project root.\n");
    exit(2);
}

$export = static fn (): array => match ($kind) {
    'policy-model-argument-contract-candidates' => (new PolicyModelArgumentContractExport)->export($root, $files),
    'policy-class-selector-call-candidates' => (new PolicyClassSelectorCallExport)->export($root, $files),
    'policy-additional-argument-contract-candidates' => (new PolicyAdditionalArgumentContractExport)->export(
        $root,
        $files,
    ),
    'middleware-parameters' => (new MiddlewareParameterMetadataExport)->export($root, $files),
    'controller-route-contract-candidates' => (new ControllerRouteContractExport)->export($root, $files),
    'routes' => (new RouteMetadataExport)->export($root, $files),
    'route-name-duplicates' => (new RouteNameDuplicateCandidates)->export($root, $files),
    'route-parameters' => (new RouteParameterMetadataExport)->export($root, $files),
    'translations' => (new TranslationMetadataExport)->export($root, $files),
    'translations-json' => (new JsonTranslationMetadataExport)->export($root, $files),
    'translation-placeholders' => (new TranslationPlaceholderExport)->export($root, $files),
    'environment-references' => (new EnvironmentTemplateReferences)->export($root, $files),
    'environment-duplicates' => (new EnvironmentTemplateDuplicates)->export($root, $files),
    'vite-environment-references' => (new ViteEnvironmentReferences)->export($root, $files),
    default => (new StaticMetadataExport)->configuration($root, $arrayKeys, $keys),
};
if ($watchMode) {
    $watch = match ($kind) {
        'routes', 'translations' => new SelectedSourceWatch($root, $files, ['php']),
        'translations-json' => new SelectedSourceWatch($root, $files, ['json']),
        default => new ConfigurationWatch($root),
    };
    $watch->run(
        $export,
        static function (array $event): void {
            $json = json_encode($event, JSON_UNESCAPED_SLASHES);
            if ($json === false) {
                $json = json_encode([
                    'event' => 'snapshot',
                    'revision' => $event['revision'],
                    'sourceHash' => $event['sourceHash'],
                    'status' => 'error',
                    'metadata' => null,
                    'errors' => [[
                        'code' => 'json-encoding-failure',
                        'file' => null,
                        'message' => 'Unable to encode static metadata as JSON.',
                    ]],
                ], JSON_UNESCAPED_SLASHES);
            }
            if ($json === false || @fwrite(STDOUT, $json."\n") === false) {
                exit(2);
            }
            fflush(STDOUT);
        },
        $intervalMs,
    );
}

$data = $export();
$json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
if ($json === false) {
    fwrite(STDERR, "Unable to encode static metadata as JSON.\n");
    exit(2);
}
$json .= "\n";
if ($output !== null) {
    if (@file_put_contents($output, $json) === false) {
        fwrite(STDERR, "Unable to write the requested output file.\n");
        exit(2);
    }
} else {
    fwrite(STDOUT, $json);
}
