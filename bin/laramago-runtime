#!/usr/bin/env php
<?php

declare(strict_types=1);

use Ichinya\Laramago\Runtime\RuntimeCliProcess;
use Ichinya\Laramago\Runtime\RuntimeSchemaCollector;
use Ichinya\Laramago\Runtime\RuntimeSchemaSnapshot;

// Deliberately do not load the package SDK in the application's runtime process.
$runtimeDirectory = dirname(__DIR__) . '/src/Runtime/';
spl_autoload_register(
    static function (string $class) use ($runtimeDirectory): void {
        $prefix = 'Ichinya\\Laramago\\Runtime\\';
        if (!str_starts_with($class, $prefix)) {
            return;
        }
        $file = $runtimeDirectory . str_replace('\\', replace: '/', subject: substr($class, strlen($prefix))) . '.php';
        if (is_file($file)) {
            require_once $file;
        }
    },
    throw: true,
    prepend: true,
);

$options = ['project-root' => null, 'autoload' => null, 'output' => null];
$models = [];
try {
    for ($index = 1, $length = count($argv); $index < $length; ++$index) {
        $argument = $argv[$index];
        if ($argument === '--help') {
            echo
                "Usage: laramago-runtime --project-root PATH --model FQN [--model FQN ...] [--autoload PATH] [--output PATH]\n"
            ;
            exit(0);
        }
        if (!str_starts_with($argument, '--')) {
            throw new RuntimeException('Invalid argument.');
        }
        [$option, $value] = array_pad(explode('=', substr($argument, offset: 2), limit: 2), length: 2, value: null);
        if ($value === null) {
            $value = $argv[++$index] ?? null;
        }
        if (!is_string($value) || $value === '' || str_starts_with($value, '--')) {
            throw new RuntimeException('Invalid argument.');
        }
        if ($option === 'model') {
            $models[] = ltrim($value, characters: '\\');
            continue;
        }
        if (array_key_exists($option, $options) && $options[$option] === null) {
            $options[$option] = $value;
            continue;
        }
        throw new RuntimeException('Invalid argument.');
    }
    if ($options['project-root'] === null || $models === []) {
        throw new RuntimeException('Missing runtime model selection.');
    }
    set_error_handler(static function (int $severity): bool {
        if ((error_reporting() & $severity) !== 0) {
            throw new RuntimeException('Runtime application warning.');
        }

        return false;
    });
    RuntimeCliProcess::isolate(__FILE__, array_slice($argv, offset: 1));
    $applicationOutput = false;
    ob_start(static function (string $buffer) use (&$applicationOutput): string {
        if ($buffer !== '') {
            $applicationOutput = true;
        }

        return '';
    }, chunk_size: 8192);
    try {
        $snapshot = RuntimeSchemaCollector::collect($options['project-root'], $options['autoload'], $models);
    } finally {
        while (ob_get_level() > 0) {
            ob_end_clean();
        }
        restore_error_handler();
    }
    if ($applicationOutput) {
        $snapshot['errors'][] = [
            'code' => 'runtime-output-rejected',
            'file' => null,
            'message' => 'Application output was rejected during runtime collection.',
        ];
    }
    $json = json_encode($snapshot, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
    if (strlen($json) > RuntimeSchemaSnapshot::MAX_BYTES) {
        throw new RuntimeException('Runtime output limit exceeded.');
    }
    if ($options['output'] === null) {
        echo $json;
        exit($snapshot['errors'] === [] && !$snapshot['truncated'] ? 0 : 1);
    }
    if (file_put_contents($options['output'], $json, flags: LOCK_EX) !== strlen($json)) {
        throw new RuntimeException('Runtime snapshot write failed.');
    }
    exit($snapshot['errors'] === [] && !$snapshot['truncated'] ? 0 : 1);
} catch (Throwable) {
    fwrite(STDERR, data: "Runtime schema collection failed.\n");
    exit(2);
}
